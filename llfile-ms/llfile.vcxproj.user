<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <LocalDebuggerCommandArguments>-xp -P=Program -e=* -p="%s\n"</LocalDebuggerCommandArguments>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerCommandArgumentsHistory>-xp -a=n -p="%s," *.bat|-xp -p="hello world"|-xp -e   "-p=%s\n"|-xp -e=PATH   "-p=%s\n"|-xp -P=Program -e=* -p="%s\n"|</LocalDebuggerCommandArgumentsHistory>
  </PropertyGroup>
</Project>